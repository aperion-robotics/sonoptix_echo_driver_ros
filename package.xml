<?xml version="1.0"?>
<package format="2">
  <name>sonoptix_echo_driver_ros</name>
  <version>0.0.1</version>
  <description>ROS Driver for the Sonoptix ECHO Multibeam Sonar (C++)</description>

  <maintainer email="gstavrinos@aperionrobotics.com">George Stavrinos</maintainer>
  <maintainer email="sbarlakas@aperionrobotics.com">Sotiris Barlakas</maintainer>

  <license>GNU-3</license>
  <author email="gstavrinos@aperionrobotics.com">George Stavrinos</author>

  <url type="website">https://github.com/ikh-innovation/sonoptix_echo_driver_ros</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>generate_parameter_library</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>libcpp-httplib-dev</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
