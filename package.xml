<?xml version="1.0"?>
<package format="2">
  <name>sonoptix_echo_driver_ros</name>
  <version>0.0.1</version>
  <description>ROS Driver for the Sonoptix ECHO Multibeam Sonar</description>

  <maintainer email="gstavrinos@iknowhow.com">George Stavrinos</maintainer>

  <license>GNU-3</license>

  <url type="website">https://github.com/ikh-innovation/sonoptix_echo_driver_ros</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
